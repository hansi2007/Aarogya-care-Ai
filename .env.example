# Aarogya Care AI - Environment Configuration Example

# Supabase Integration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Google Gemini AI Integration
# Obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional: PostgreSQL Direct Connection (if using Drizzle with Supabase Transaction pooler)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
